# Wera server settings. Copy to .env (./deploy.sh init does it), fill in,
# keep it mode 600, and never commit it.

# --- Required ---------------------------------------------------------------
# The domain the site is served on, without https:// (DNS A record -> server).
WERA_DOMAIN=wera-jobs.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com
# Database password. ./deploy.sh init fills in a random one.
POSTGRES_PASSWORD=
CORAL_API_KEY=cb_xxx

# --- Image versions ---------------------------------------------------------
# "latest" follows each release. Pin a release tag (e.g. wera-v0.2.1,
# wera-frontend-v0.2.0, wera-admin-v0.2.0) to upgrade only on purpose.
WERA_TAG=latest
WERA_WEB_TAG=latest
WERA_ADMIN_TAG=latest

# --- Inference --------------------------------------------------------------
CORAL_BASE_URL=https://inference.coralbricks.ai/v1
CORAL_MODEL=deepseek-v4.1-flash-fast
CORAL_DEEP_MODEL=glm-5.3-fast
SCORING_CONCURRENCY=12
FETCH_CONCURRENCY=6
MAX_COST_PER_RUN_USD=1.00
USER_MONTHLY_BUDGET_USD=10
MAX_MONTHLY_COST_USD=100

# --- Worker schedule --------------------------------------------------------
RUN_SCHEDULE=09:00,11:00,13:00,15:00,17:00,19:00
RUN_TIMEZONE=America/Chicago
RUN_INTERVAL=30m
USER_AGENT=Wera/0.2 (job tracker; contact: you@example.com)

# --- Accounts ---------------------------------------------------------------
SIGNUP_ENABLED=true
SIGNUPS_PER_HOUR=5

# --- Email (off until MAIL_PROVIDER is set) ---------------------------------
# Hetzner blocks outgoing ports 25 and 465 on new servers: use 587 + starttls.
# PUBLIC_URL is set from WERA_DOMAIN in compose.yml.
# MAIL_PROVIDER=smtp
# MAIL_FROM=Wera <hello@wera-jobs.com>
# MAIL_REPLY_TO=support@wera-jobs.com
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls

# --- Backups ----------------------------------------------------------------
# ./deploy.sh backup keeps this many daily dumps in ./backups.
BACKUP_KEEP=14
