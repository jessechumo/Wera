# Wera local environment. Copy to .env and fill in. NEVER commit .env.
# Everything here can also be set as real environment variables (they win).

# Port 5433 because a native PostgreSQL already occupies 5432 on this laptop.
DATABASE_URL=postgres://wera:wera@localhost:5433/wera?sslmode=disable
# Postgres password for docker compose (defaults to "wera"). On a server, set a
# random one (openssl rand -hex 24) and use it in DATABASE_URL above too.
POSTGRES_PASSWORD=wera
CORAL_API_KEY=cb_xxx                       # never log this, never commit this
CORAL_BASE_URL=https://inference.coralbricks.ai/v1
CORAL_MODEL=deepseek-v4.1-flash-fast
CORAL_DEEP_MODEL=glm-5.3-fast              # used only for optional deep review (Milestone 7)
SCORING_CONCURRENCY=12
FETCH_CONCURRENCY=6
# Worker runs at these local times every day. Leave RUN_SCHEDULE empty to
# loop every RUN_INTERVAL instead.
RUN_SCHEDULE=09:00,11:00,13:00,15:00,17:00,19:00
RUN_TIMEZONE=America/Chicago
RUN_INTERVAL=30m
HTTP_ADDR=127.0.0.1:8080
LOG_FORMAT=text                            # json on the server
# Inference spending limits. Each run spends at most MAX_COST_PER_RUN_USD per
# user; each user has a monthly budget (new accounts get
# USER_MONTHLY_BUDGET_USD; change one with `wera users budget`); all users
# together stop at MAX_MONTHLY_COST_USD per calendar month.
MAX_COST_PER_RUN_USD=1.00
USER_MONTHLY_BUDGET_USD=10
MAX_MONTHLY_COST_USD=100
USER_AGENT=Wera/0.1 (personal job tracker; contact: jessechumo@gmail.com)
WEB_PORT=3000                              # dashboard port for docker compose (wera-web)

# Accounts. Anyone who can reach the site can sign up while SIGNUP_ENABLED
# is true. Behind HTTPS (Cloudflare Tunnel, Vercel) set COOKIE_SECURE=true,
# TRUST_PROXY=true, and list the dashboard's public origin(s).
SIGNUP_ENABLED=true
# Sign-ups allowed per client IP per hour (raise for end-to-end tests).
SIGNUPS_PER_HOUR=5
COOKIE_SECURE=false
TRUST_PROXY=false
PUBLIC_ORIGINS=                            # e.g. https://wera.vercel.app

# Resume rendering: path to the typst binary (default: typst on PATH).
# TYPST_BIN=/usr/local/bin/typst
