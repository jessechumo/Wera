# Wera local environment. Copy to .env and fill in. NEVER commit .env.
# Everything here can also be set as real environment variables (they win).

# Port 5433 because a native PostgreSQL already occupies 5432 on this laptop.
DATABASE_URL=postgres://wera:wera@localhost:5433/wera?sslmode=disable
# Postgres password for docker compose (defaults to "wera"). On a server, set a
# random one (openssl rand -hex 24) and use it in DATABASE_URL above too.
POSTGRES_PASSWORD=wera
# AI provider: any OpenAI-compatible chat API. AI_PROVIDER picks a preset
# (coral | deepinfra | openai); the AI_* lines below override it. The older
# CORAL_* names still work while the provider is coral.
AI_PROVIDER=coral
AI_API_KEY=xxx                             # never log this, never commit this
# AI_MODEL=deepseek-v4.1-flash-fast        # default per provider: coral deepseek-v4.1-flash-fast,
#                                          # deepinfra deepseek-ai/DeepSeek-V4.1-Flash
# AI_DEEP_MODEL=glm-5.3-fast               # heavier calls (deep review); defaults per provider
# AI_BASE_URL=                             # required for AI_PROVIDER=openai (any compatible API)
# A model Wera has no price for needs one (USD per 1M tokens), or budgets
# could not be enforced:
# AI_PRICE_INPUT=0.20
# AI_PRICE_CACHED_INPUT=0.006
# AI_PRICE_OUTPUT=0.60
# Extra JSON merged into every request, for model-specific options:
# AI_EXTRA_BODY={"reasoning_effort":"none"}
SCORING_CONCURRENCY=12
FETCH_CONCURRENCY=6
# Worker runs at these local times every day. Leave RUN_SCHEDULE empty to
# loop every RUN_INTERVAL instead.
RUN_SCHEDULE=09:00,11:00,13:00,15:00,17:00,19:00
RUN_TIMEZONE=America/Chicago
RUN_INTERVAL=30m
HTTP_ADDR=127.0.0.1:8080
LOG_FORMAT=text                            # json on the server
# Inference spending limits. Each run spends at most MAX_COST_PER_RUN_USD per
# user; each user has a monthly budget (new accounts get
# USER_MONTHLY_BUDGET_USD; change one with `wera users budget`); all users
# together stop at MAX_MONTHLY_COST_USD per calendar month.
MAX_COST_PER_RUN_USD=1.00
USER_MONTHLY_BUDGET_USD=10
MAX_MONTHLY_COST_USD=100
USER_AGENT=Wera/0.1 (personal job tracker; contact: jessechumo@gmail.com)
WEB_PORT=3000                              # dashboard port for docker compose (wera-web)

# --- Ranking and AI score limits --------------------------------------------
# Every pending job is ranked for each user by a local embedding model (the
# wera-embed container; compose sets EMBED_BASE_URL). Only the best ranked
# get a paid AI score; the rest show an estimate and are scored when the
# user opens them. Leave EMBED_BASE_URL empty to rank by word matching.
# EMBED_BASE_URL=http://wera-embed/v1
# EMBED_MODEL=Snowflake/snowflake-arctic-embed-m-v1.5
SCORES_PER_DAY=100              # AI scores per user per 24 hours (0 = no limit)
SCORES_PER_RUN=30               # per run once a profile has scores (0 = no limit)
INACTIVE_AFTER_DAYS=7           # users unseen this long get...
INACTIVE_SCORES_PER_DAY=10      # ...enough for their digest (none without one)

# Accounts. Anyone who can reach the site can sign up while SIGNUP_ENABLED
# is true. Behind HTTPS (Cloudflare Tunnel, Vercel) set COOKIE_SECURE=true,
# TRUST_PROXY=true, and list the dashboard's public origin(s).
SIGNUP_ENABLED=true
# Sign-ups allowed per client IP per hour (raise for end-to-end tests).
SIGNUPS_PER_HOUR=5
COOKIE_SECURE=false
TRUST_PROXY=false
PUBLIC_ORIGINS=                            # e.g. https://wera.vercel.app

# Resume rendering: path to the typst binary (default: typst on PATH).
# TYPST_BIN=/usr/local/bin/typst

# --- Email (off until MAIL_PROVIDER is set) ---------------------------------
# log: development; messages go to the log (and MAIL_LOG_DIR as .eml/.html)
# smtp: any provider with SMTP (Google Workspace, Zoho, Amazon SES, Resend, Postmark)
# MAIL_PROVIDER=log
# MAIL_FROM=Wera <hello@your-domain.com>
# MAIL_REPLY_TO=support@your-domain.com
# PUBLIC_URL=https://wera.your-domain.com      # the dashboard, for links in emails
# MAIL_LOG_DIR=./email-out
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls                      # starttls (587), tls (465) or none (local relay)
